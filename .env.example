# Google Calendar Integration
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=credentials.json

# ─────────────────────────────────────────────
# Groq API — STT (Whisper) + LLM (Llama 3.3 70B)
# Бесплатный ключ: https://console.groq.com
#   1. Login with Google
#   2. API Keys → Create API Key
#   3. Скопировать и вставить сюда
# ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# Модель LLM (не менять)
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# URL нашего FastAPI сервиса (issai_service.py)
ISSAI_SERVICE_URL=http://localhost:8001

# Ключ защиты нашего FastAPI (оставьте пустым если не нужен)
SERVICE_API_KEY=

# Настройки локального Whisper
USE_LOCAL_WHISPER=true
LOCAL_WHISPER_MODEL=shyngys879/kazakh-whisper-large-v3-turbo
